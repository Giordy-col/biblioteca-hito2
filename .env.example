# Copia este archivo a ".env" (mismo nombre, sin ".example") si quieres
# cambiar algún valor. Con los valores por defecto de docker-compose.yml
# (sin crear .env) el entorno ya funciona para todas las prácticas del curso.
#
#   cp .env.example .env

# --- PostgreSQL ---
POSTGRES_USER=curso
POSTGRES_PASSWORD=curso
POSTGRES_DB=curso
POSTGRES_PORT=5432

# --- pgAdmin ---
PGADMIN_DEFAULT_EMAIL=estudiante@curso.edu.co
PGADMIN_DEFAULT_PASSWORD=curso
PGADMIN_PORT=5050

# --- Node.js ---
NODE_PORT=3000
